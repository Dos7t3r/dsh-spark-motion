{
  "name": "dsh-spark-motion",
  "version": "0.4.0",
  "description": "Choose the thinking/working indicator animation in DeepSeek Harness: the DeepSeek whale tail, Anthropic's classic Claude spark, or Claude's current dots.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "NOTICE.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "animation",
    "thinking",
    "claude",
    "spark",
    "spinner"
  ],
  "author": "Dos7t3r",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dos7t3r/dsh-spark-motion.git"
  },
  "bugs": {
    "url": "https://github.com/Dos7t3r/dsh-spark-motion/issues"
  },
  "homepage": "https://github.com/Dos7t3r/dsh-spark-motion#readme"
}
